# ============================================================================
#  PERFUME SITE — Environment Variables
#  Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# ----------------------------------------------------------------------------
#  Database (PostgreSQL — Railway / Supabase)
# ----------------------------------------------------------------------------
# Pooled connection string used by the app at runtime (PgBouncer-friendly).
DATABASE_URL="postgresql://user:password@host:5432/perfume_site?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate. On Railway this is the
# same as DATABASE_URL; on Supabase use the direct 5432 connection here.
DIRECT_URL="postgresql://user:password@host:5432/perfume_site?schema=public"

# ----------------------------------------------------------------------------
#  Clerk (Authentication)
#  https://dashboard.clerk.com → API Keys
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"
# Signing secret for the Clerk webhook endpoint (Dashboard → Webhooks → Signing Secret)
CLERK_WEBHOOK_SECRET="whsec_your_key_here"
# Clerk routing — where the sign-in/up flows live and where to send users after.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ----------------------------------------------------------------------------
#  Stripe (Payments)
#  https://dashboard.stripe.com/apikeys
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
# Webhook signing secret (Dashboard → Developers → Webhooks → Signing secret,
# or `stripe listen` output during local development).
STRIPE_WEBHOOK_SECRET="whsec_your_key_here"
# Subscription discovery-box recurring price IDs (Dashboard → Products).
# Without these the subscription plans cannot be purchased.
STRIPE_DISCOVERY_BOX_PRICE_ID=""
STRIPE_CONNOISSEUR_BOX_PRICE_ID=""

# ----------------------------------------------------------------------------
#  Cloudinary (Image storage / CDN)
#  https://console.cloudinary.com → Dashboard
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Public cloud name for client-side <Image> / upload widgets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Unsigned upload preset used by the admin Cloudinary upload widget.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="perfume-site-unsigned"

# ----------------------------------------------------------------------------
#  Algolia (Search)
#  https://dashboard.algolia.com → Settings → API Keys
# ----------------------------------------------------------------------------
ALGOLIA_APP_ID="XXXXXXXXXX"
# Admin key — server-side only, used for indexing. Keep secret.
ALGOLIA_ADMIN_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
ALGOLIA_INDEX_NAME="perfumes"
# Public, search-only key safe to expose to the browser.
NEXT_PUBLIC_ALGOLIA_APP_ID="XXXXXXXXXX"
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ----------------------------------------------------------------------------
#  Resend (Transactional email)
#  https://resend.com/api-keys
# ----------------------------------------------------------------------------
RESEND_API_KEY="re_your_key_here"
# Verified sender address and a friendly display name.
EMAIL_FROM="Decanturi Niche <comenzi@your-domain.com>"
EMAIL_REPLY_TO="suport@your-domain.com"
# Resend Audience id for newsletter subscribers (Dashboard → Audiences).
RESEND_AUDIENCE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ----------------------------------------------------------------------------
#  Application
# ----------------------------------------------------------------------------
# Canonical site URL — used for absolute links in emails, Stripe redirects, SEO.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Free-shipping threshold and flat shipping fee, in RON.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="200"
NEXT_PUBLIC_SHIPPING_FEE="15"

# ----------------------------------------------------------------------------
#  Upstash Redis (Rate limiting — optional; disabled when absent)
#  https://console.upstash.com → Redis → REST API
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
#  Sentry (Error monitoring — optional; disabled when DSN absent)
#  https://sentry.io → Settings → Projects → Client Keys (DSN)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload during build (Settings → Auth Tokens).
SENTRY_AUTH_TOKEN=

# ----------------------------------------------------------------------------
#  Anthropic — AI parfum assistant (optional; /asistent degrades gracefully)
# ----------------------------------------------------------------------------
# Get from console.anthropic.com. Without it, the AI assistant shows a
# "funcționalitate indisponibilă" message instead of crashing.
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
#  Cron & operational alerts
# ----------------------------------------------------------------------------
# Shared secret guarding /api/cron/* (set the same value in Vercel + cron header).
CRON_SECRET=
# Recipient for low-stock and operational alert emails.
ADMIN_EMAIL="admin@your-domain.com"

# ----------------------------------------------------------------------------
#  Company / invoicing (Phase 7 — optional; placeholders used on the PDF if blank)
# ----------------------------------------------------------------------------
COMPANY_NAME="DecantLux SRL"
COMPANY_CUI="RO12345678"
COMPANY_ADDRESS="Str. Exemplu nr. 1, București, România"
COMPANY_IBAN="RO49 AAAA 1B31 0075 9384 0000"
COMPANY_BANK="Banca Transilvania"

# ----------------------------------------------------------------------------
#  FanCourier AWB (Phase 7 — optional; AWB generation disabled when blank)
#  https://api.fancourier.ro — account credentials + client id
# ----------------------------------------------------------------------------
FANCOURIER_USERNAME=
FANCOURIER_PASSWORD=
FANCOURIER_CLIENT_ID=

# ----------------------------------------------------------------------------
#  Web push / VAPID (Phase 7 — optional; push disabled when blank)
#  Generate a key pair with:  npx web-push generate-vapid-keys
# ----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ----------------------------------------------------------------------------
#  Cash on Delivery (Phase 7 — optional tuning)
# ----------------------------------------------------------------------------
# COD orders at/under this RON total auto-deduct stock; larger orders wait for
# admin confirmation. Defaults to 500.
COD_AUTO_CONFIRM_THRESHOLD="500"

# ----------------------------------------------------------------------------
#  Returns portal (Phase 8 — optional)
# ----------------------------------------------------------------------------
# Warehouse address shown to customers in return-approval emails.
RETURN_WAREHOUSE_ADDRESS=

# ----------------------------------------------------------------------------
#  Vercel deploy (Phase 8 — CI/CD; deploy workflow is skipped when unset)
#  VERCEL_ORG_ID / VERCEL_PROJECT_ID come from `.vercel/project.json` after
#  running `vercel link`. Create a token at Vercel → Account Settings → Tokens.
# ----------------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
